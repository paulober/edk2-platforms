[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = Rp1BusDxe
  FILE_GUID                      = 7d4843f2-f474-40b1-87de-4d67fad8b00f
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 2.0
  ENTRY_POINT                    = Rp1BusDxeEntryPoint

[Sources]
  Rp1BusDxe.c
  ComponentName.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  NetworkPkg/NetworkPkg.dec
  Platform/RaspberryPi/RaspberryPi.dec
  Silicon/RaspberryPi/RpiSiliconPkg/RpiSiliconPkg.dec

[LibraryClasses]
  BoardInfoLib
  DebugLib
  IoLib
  MemoryAllocationLib
  NetLib
  NonDiscoverableDeviceRegistrationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gEfiPciIoProtocolGuid                         ## TO_START
  gRp1BusProtocolGuid                           ## BY_START
  gEdkiiNonDiscoverableDeviceProtocolGuid       ## BY_START
  gEfiDevicePathProtocolGuid                    ## BY_START
  gRp1GpioDeviceProtocolGuid                    ## PRODUCES
  gRp1EthernetPlatformDeviceProtocolGuid        ## PRODUCES
  gRaspberryPiFirmwareProtocolGuid              ## CONSUMES

[Depex]
  gRaspberryPiFirmwareProtocolGuid
