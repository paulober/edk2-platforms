#include <Rp1.h>

#define RP1_QWORDMEMORY_BUF(Index)                              \
  QWordMemory (ResourceConsumer,,                               \
    MinFixed, MaxFixed, NonCacheable, ReadWrite,                \
    0x0, 0x0, 0x0, 0x0, 0x1,,, RB ## Index)

#define RP1_QWORDMEMORY_SET(Index, Offset, Length)              \
  CreateQwordField (RBUF, RB ## Index._MIN, MI ## Index)        \
  CreateQwordField (RBUF, RB ## Index._MAX, MA ## Index)        \
  CreateQwordField (RBUF, RB ## Index._LEN, LE ## Index)        \
  LE ## Index = Length                                          \
  MI ## Index = PBAR + Offset                                   \
  MA ## Index = MI ## Index + LE ## Index - 1

#define RP1_INTERRUPT_BUF(Index)                          \
  Interrupt (ResourceConsumer, Level, ActiveHigh, Shared,,,     \
             RB ## Index) { 0 }

#define RP1_INTERRUPT_SET(Index)                                \
  CreateDwordField (RBUF, RB ## Index._INT, IN ## Index)        \
  IN ## Index = PINT

Device (XHC0) {
  Name (_HID, "PNP0D10")
  Name (_UID, 0x0)

  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      RP1_QWORDMEMORY_BUF (00)
      RP1_INTERRUPT_BUF (01)
    })
    RP1_QWORDMEMORY_SET (00, RP1_USBHOST0_BASE, RP1_USBHOST_SIZE)
    RP1_INTERRUPT_SET (01)
    Return (RBUF)
  }
}

Device (XHC1) {
  Name (_HID, "PNP0D10")
  Name (_UID, 0x1)

  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      RP1_QWORDMEMORY_BUF (00)
      RP1_INTERRUPT_BUF (01)
    })
    RP1_QWORDMEMORY_SET (00, RP1_USBHOST1_BASE, RP1_USBHOST_SIZE)
    RP1_INTERRUPT_SET (01)
    Return (RBUF)
  }
}

Device (GPIO)
{
  Name (_HID, "RPIL002")
  // Generic GPIO id for compatibility
  Name (_CID, "PNP0C40")
  Name (_UID, 0x0)
  // Name (_CCA, 0x0) already inherited from the parent device (RP1)

  Method (_CRS, 0, Serialized)
  {
    Name (RBUF, ResourceTemplate ()
    {
      RP1_QWORDMEMORY_BUF (00)
      RP1_QWORDMEMORY_BUF (01)
      RP1_QWORDMEMORY_BUF (02)

      RP1_INTERRUPT_BUF (03)
    })

    RP1_QWORDMEMORY_SET (00, RP1_IO_BANK0_BASE, RP1_GPIO_REGION_SIZE)
    RP1_QWORDMEMORY_SET (01, RP1_SYS_RIO0_BASE, RP1_GPIO_REGION_SIZE)
    RP1_QWORDMEMORY_SET (02, RP1_PADS_BANK0_BASE, RP1_GPIO_REGION_SIZE)

    // Only GSI261 because ACPI has no built-in support for MSI-X vector indexing
    RP1_INTERRUPT_SET (03)

    Return (RBUF)
  }

  // No _STA => 0xF (always on) assumed by default
  // but to be explicit, we can add it here:
  Method (_STA)
  {
    Return (0xF) // always present and functional
  }

  // Device-Specific Data for Linux compatibility
  Name (_DSD, Package ()
  {
    // Device Properties UUID
    ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301"),
    Package ()
    {
      Package () { "compatible", "raspberrypi,rp1-gpio" },
      Package () { "gpio-controller", One },
      Package () { "#gpio-cells", 2 },
      Package () { "interrupt-controller", One },
      Package () { "#interrupt-cells", 2 },
      Package () { "gpio-ranges", Package () { \_SB.RP1B.GPIO, 0, 0, 54 } }
    }
  })
}

Device (ETH0)
{
    Name (_HID, "RPIL003")
    Name (_UID, 0)
    // _CCA is inherited from the parent device (RP1)
    // No _STA => 0xF (always on) assumed by default
    // but to be explicit, we can add it here:
    Method (_STA)
    {
      Return (0xf)
    }

    Name (PINT, RP1_INT_ETH)

    // Register resource
    Method (_CRS, 0, Serialized)
    {
      Name (RBUF, ResourceTemplate () {
        RP1_QWORDMEMORY_BUF (00)
        RP1_INTERRUPT_BUF (01)
      })
      RP1_QWORDMEMORY_SET (00, RP1_ETH_BASE, RP1_ETH_SIZE)
      // GSI261 because ACPI has no built-in support for MSI-X vector indexing
      RP1_INTERRUPT_SET (01)
      Return (RBUF)
    }

    // Optional _DSD for Linux compatibility
    Name (_DSD, Package ()
    {
      // Device properties UUID
      ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301"),
      Package ()
      {
        Package () 
        { 
          "compatible", 
          Package ()
          {
            "raspberrypi,rp1-gem",
            "cdns,macb"
          }
        },
        Package () { "phy-mode", "rgmii-id" },
        // TODO: maybe add and patch at runtime
        //Package () { "local-mac-address", Buffer() { 0x00,0x00,0x00,0x00,0x00,0x00 } },
        Package () { "cdns,aw2w-max-pipe", 8 },
        Package () { "cdns,ar2r-max-pipe", 8 },
        Package () { "cdns,use-aw2b-fill", 1 },
      }
    })
}
